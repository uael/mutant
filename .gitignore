# Ignore everything
*

# Git
# !.git and !.git/** are needed for release-plz, which uses the `ignore` crate
# to copy the repo to a temp dir. Without these, the deny-all `*` pattern
# causes .git internals to be skipped, breaking the copy. (release-plz#1961)
!.git
!.git/**
!.gitignore

# Project
!README.md
!CHANGELOG.md
!LICENSE-*
!deny.toml
!release-plz.toml
!.github/
!.github/workflows/
!.github/**/*.yml

# Rust
!Cargo.toml
!Cargo.lock
!rust-toolchain
!rustfmt.toml
!clippy.toml
!.cargo/
!.cargo/config.toml
!puns/
!puns/Cargo.toml
!puns/DESIGN.md
!puns/benches/
!puns/examples/
!puns/examples/*.image
!puns/src/
!puns/tests/
!puns/tests/compile-fail/
!puns/tests/compile-fail/*.stderr
!puns/tests/compile-pass/
!puns/tests/compile-fail-nearest/
!puns/tests/compile-fail-nearest/*.stderr
!puns/tests/compile-pass-nearest/
!puns/**/*.rs
!puns-derive/
!puns-derive/Cargo.toml
!puns-derive/src/
!puns-derive/**/*.rs

# Rust (model check, not published)
!puns-model/
!puns-model/Cargo.toml
!puns-model/src/
!puns-model/tests/
!puns-model/fakecore/
!puns-model/fakecore/Cargo.toml
!puns-model/fakecore/src/
!puns-model/**/*.rs

# Rust (xtask)
!xtask/
!xtask/Cargo.toml
!xtask/src/
!xtask/**/*.rs

# Claude
!CLAUDE.md
!puns/CLAUDE.md
!.claude/
!.claude/settings.json
!.claude/commands/
!.claude/**/*.md
